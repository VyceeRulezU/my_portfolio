# --- Browser (exposed to the client; public values only) ---
# Public R2 bucket URL, e.g. https://pub-xxxx.r2.dev
VITE_CLOUDFLARE_URL=
# Worker that lists images in an R2 folder: GET ?project=<folder> -> { images: [...] }
VITE_GALLERY_API_URL=
# Set to true after `npm run r2:upload -- --optimize` so the site loads resized WebP copies from R2
VITE_R2_OPTIMIZED=

# --- Scripts / Vercel functions only (never prefix with VITE_) ---
# Sanity token with Editor rights, for scripts that write content
SANITY_WRITE_TOKEN=
# Sanity read token for api/unlock.js; only needed if the dataset is private
SANITY_READ_TOKEN=

# R2 S3 API credentials for scripts/r2-upload.js
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
